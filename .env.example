# OpenAI — omit both values to use the deterministic local report engine.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional. Enables a real mobile screenshot and performance score in Visibility Audit reports.
PAGESPEED_API_KEY=

# GoHighLevel Private Integration (single sub-account/location).
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
GHL_USER_ID=
GHL_API_VERSION=v3

# Contact custom field IDs created in GoHighLevel.
GHL_FIELD_AUDIT_SUMMARY=audit_opportunity
GHL_FIELD_OPPORTUNITY_1=audit_opportunity_1
GHL_FIELD_OPPORTUNITY_2=audit_opportunity_2
GHL_FIELD_OPPORTUNITY_3=audit_opportunity_3
GHL_FIELD_RECOMMENDED_SYSTEM=recommended_system
GHL_FIELD_AUDIT_COMPLETED_AT=audit_completed_at

# Optional Search + AI Visibility Audit custom field IDs.
GHL_FIELD_VISIBILITY_SCORE=
GHL_FIELD_VISIBILITY_RATING=
GHL_FIELD_VISIBILITY_REPORT=

# Optional Growth Game custom field IDs. Answers and recommendations are also saved in a contact note.
GHL_FIELD_GROWTH_SCORE=
GHL_FIELD_GROWTH_LEVEL=
GHL_FIELD_GROWTH_PACKAGE=

# ID of a GoHighLevel chat widget configured as Embedded / Inline.
NEXT_PUBLIC_GHL_VOXPAGE_INLINE_WIDGET_ID=

# Optional booking destination used by the Visibility Audit report CTA.
NEXT_PUBLIC_STRATEGY_CALL_URL=

# Feria Effix 2026. Reuses the GHL private integration above (server only).
# Keep registration disabled until the CRM and Spanish privacy notice are reviewed.
EFFIX_ENABLED=false
EFFIX_PRIVACY_APPROVED=false
# A random secret of at least 32 characters; signs receipts, never NEXT_PUBLIC.
EFFIX_RECEIPT_SECRET=
# Effix reuses GHL_PRIVATE_INTEGRATION_TOKEN and GHL_USER_ID above.
# Sub-account ue94rPvevtVT7o7wCQt2 and pipeline 4o6WiPB5RnPKn70WzABN
# are configured in app/es/feriaEffix2026/_lib/crm.ts.
# Each new opportunity uses the current first pipeline stage, read from GHL.
# No GHL_EFFIX_PIPELINE_ID / STAGE_NEW_ID / STAGE_BENEFIT_ID are needed.
GHL_EFFIX_STAGE_BOOKED_ID=
GHL_EFFIX_STAGE_COORDINATION_ID=
# Existing or dedicated calendar with a 15-minute duration.
GHL_EFFIX_CALENDAR_ID=
EFFIX_CALENDAR_REQUIRES_EMAIL=false
# Published coupon confirmation workflow in the Effix subaccount. Disable workflow re-entry.
GHL_EFFIX_COUPON_WORKFLOW_ID=
# Authorized tag IDs mapped to salesperson names; unknown IDs stay unassigned.
EFFIX_SELLERS_JSON={}
# Opportunity custom field IDs. Used by GHL workflows; consent snapshots also live in notes.
GHL_EFFIX_FIELDS_JSON={}

# experienciaEffix image mockups: server-side OpenAI Images API (same OPENAI_API_KEY).
# No API call without a logo and explicit generation action/consent in the experience.
# Omit to allow generation when OPENAI_API_KEY is configured; false disables it.
EFFIX_IMAGE_GENERATION_ENABLED=true
EFFIX_IMAGE_MODEL=gpt-image-1.5

# Diagnóstico EFFIX: búsqueda con fuentes y consulta de fichas públicas.
# OPENAI_API_KEY existente permite búsqueda web de candidatos.
EFFIX_DISCOVERY_MODEL=gpt-5.4
# Opcional: habilitar Places API (New) en Google Cloud.
GOOGLE_PLACES_API_KEY=
# PAGESPEED_API_KEY (arriba) habilita la medición móvil; sin ella queda pendiente.
