# OpenAI — omit both values to use the deterministic local report engine.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional. Enables a real mobile screenshot and performance score in Visibility Audit reports.
PAGESPEED_API_KEY=

# GoHighLevel Private Integration (single sub-account/location).
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
GHL_USER_ID=
GHL_API_VERSION=v3

# Contact custom field IDs created in GoHighLevel.
GHL_FIELD_AUDIT_SUMMARY=audit_opportunity
GHL_FIELD_OPPORTUNITY_1=audit_opportunity_1
GHL_FIELD_OPPORTUNITY_2=audit_opportunity_2
GHL_FIELD_OPPORTUNITY_3=audit_opportunity_3
GHL_FIELD_RECOMMENDED_SYSTEM=recommended_system
GHL_FIELD_AUDIT_COMPLETED_AT=audit_completed_at

# Optional Search + AI Visibility Audit custom field IDs.
GHL_FIELD_VISIBILITY_SCORE=
GHL_FIELD_VISIBILITY_RATING=
GHL_FIELD_VISIBILITY_REPORT=

# Optional Growth Game custom field IDs. Answers and recommendations are also saved in a contact note.
GHL_FIELD_GROWTH_SCORE=
GHL_FIELD_GROWTH_LEVEL=
GHL_FIELD_GROWTH_PACKAGE=

# ID of a GoHighLevel chat widget configured as Embedded / Inline.
NEXT_PUBLIC_GHL_VOXPAGE_INLINE_WIDGET_ID=

# Optional booking destination used by the Visibility Audit report CTA.
NEXT_PUBLIC_STRATEGY_CALL_URL=
